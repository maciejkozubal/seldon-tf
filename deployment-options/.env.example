# --- auth (secrets) ---
# TFY_API_KEY wins over `tfy login` — these two pin the tenant
TFY_HOST=https://internal.devtest.truefoundry.tech
TFY_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# --- names ---
MODEL_NAME=iris-model               # used for: local folder, model version, and service name
MODEL_FILE=model.joblib                 # file inside model/ (server.py loads model/model.joblib)
# written by 2a1 / 2a2
MODEL_FQN=model:truefoundry/default/iris-blob-sdk:1
# separate names per source + surface, so the UI list is self-explanatory
# (hyphens, not underscores: model names are DNS-style)
MODEL_NAME_UPLOAD=iris-upload-sdk
MODEL_NAME_BLOB=iris-blob-sdk
MODEL_REGISTRY=default        # ml-repo the model sits in

# --- azure blob ---
CONTAINER=tfyeausdemocn
STORAGE_FQN=truefoundry:azure:truefoundry-default:blob-storage:truefoundry-default-storage  # backs the ml-repo

# --- deploy target ---
WS=tfy-usea1-devtest:seldon-tf
CLUSTER_FQN=tfy-usea1-devtest
WORKSPACE_NAME=seldon-tf
PORT=8000
ADMIN=user:maciej.kozubal@truefoundry.com   # ml-repo admin collaborator
# 4.1 only. It picks the tag from the bake flag and writes IMAGE +
# IMAGE_DIGEST back, so the two model options never collide.
# needs `docker login`
IMAGE_BASE=mkozubal/iris
IMAGE=
IMAGE_DIGEST=

# --- blob prefix. 2a2's URI must sit inside the ML REPO's artifact root, not just
# inside the storage integration, or it fails with 'Invalid source URI'.
# Root shape: <integration root>/mlfoundry/<repo>_<repo id>. Repo id is in the
# repo page URL (/repositories/2213). ---
REPO_ROOT=tfy-managed-storage/truefoundry/mlfoundry/default_2213
SRC_PREFIX=$REPO_ROOT/external/$MODEL_NAME
# model pointer, used by: model-version registration
URI=wasbs://$CONTAINER@tfyeausdemosa.blob.core.windows.net/$SRC_PREFIX/
# service endpoint, used by: manifest ports and inference curl
HOST=$MODEL_NAME-seldon-tf-8000.tfy-usea1-ctl.devtest.truefoundry.tech

# --- git ---
GIT_REPO_URL=https://github.com/maciejkozubal/seldon-tf
GIT_BRANCH=main
GIT_REF=2101ec326bfed346ee4358a5b0a1153d031fe5f4
GIT_DOCKERFILE_PATH=deployment-options/serving/Dockerfile
GIT_BUILD_CONTEXT=deployment-options/serving
GIT_LOCAL=/Users/maciej/work/seldon-tf   # local clone the notebook pushes from
