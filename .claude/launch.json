    },
    {
      "name": "triton",
      "runtimeExecutable": "kubectl",
      "runtimeArgs": ["apply", "-f", "core-2/triton.yaml", "-n", "seldon-mesh"],
      "port": 8000
    },
    {
      "name": "seldon-pvs",
      "runtimeExecutable": "kubectl",
      "runtimeArgs": ["apply", "-f", "core-2/seldon-pvs.yaml"],
      "port": 0
    }
  ]
}
