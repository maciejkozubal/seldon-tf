{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kafka",
      "runtimeExecutable": "kubectl",
      "runtimeArgs": ["apply", "-f", "core-2/kafka.yaml", "-f", "core-2/kafka-nodepool.yaml", "-n", "seldon-mesh"],
      "port": 9092
    },
    {
      "name": "mlserver",
      "runtimeExecutable": "kubectl",
      "runtimeArgs": ["apply", "-f", "core-2/mlserver.yaml", "-n", "seldon-mesh"],
